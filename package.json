{
  "name": "mymail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MyMail: email hosting on your own domain.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/entry/node.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsx scripts/build-server.ts",
    "start": "node dist/server/node.js",
    "db:generate": "drizzle-kit generate && tsx scripts/bundle-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:worker": "tsx scripts/build-worker.ts",
    "build:preview": "npm run build:web && tsx scripts/build-worker.ts --profile preview",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run lint:copy && npm test",
    "lint:copy": "tsx scripts/check-copy.ts",
    "mailserver:setup": "tsx scripts/stalwart-setup.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.13",
    "@sentry/cloudflare": "^11.8.0",
    "@sentry/node": "^11.8.0",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5.104.5",
    "better-auth": "^1.7.12",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "postal-mime": "^4.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "standardwebhooks": "^1.1.1",
    "stripe": "^23.0.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "imapflow": "^2.9.1",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.5.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
