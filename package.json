{
  "name": "mymail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multies: email hosting on your own domain.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/entry/node.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsx scripts/build-server.ts",
    "start": "node dist/server/node.js",
    "db:generate": "drizzle-kit generate && tsx scripts/bundle-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:worker": "tsx scripts/build-worker.ts",
    "build:preview": "npm run build:web && tsx scripts/build-worker.ts --profile preview",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run lint:copy && npm test",
    "lint:copy": "tsx scripts/check-copy.ts",
    "mailserver:setup": "tsx scripts/stalwart-setup.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "design:audit": "node scripts/design-audit.mjs",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "test:coverage": "vitest run --coverage",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "security": "node scripts/security-check.mjs",
    "hooks:install": "git config core.hooksPath scripts/githooks"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@react-email/components": "^1.0.12",
    "@scalar/hono-api-reference": "^0.12.13",
    "@sentry/cloudflare": "^11.8.0",
    "@sentry/node": "^11.8.0",
    "@sentry/react": "^11.8.0",
    "@svar-ui/react-gantt": "^2.8.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-caret": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.12",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cockatiel": "^4.0.0",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "email-reply-parser": "^2.3.9",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "jose": "^6.2.13",
    "lib0": "^0.2.119",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^1.61.0",
    "mailauth": "^8.0.4",
    "nodemailer": "^10.2.1",
    "papaparse": "^5.7.0",
    "postal-mime": "^4.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "standardwebhooks": "^1.1.1",
    "stripe": "^23.0.1",
    "uqr": "^0.1.3",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "imapflow": "^2.9.1",
    "otpauth": "^9.5.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
