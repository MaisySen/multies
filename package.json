{
  "name": "mymail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multies: email hosting on your own domain.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/entry/node.ts",
    "dev:web": "node scripts/restore-vendor.mjs && vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "node scripts/restore-vendor.mjs && tsx scripts/build-llms.ts && vite build && tsx scripts/build-sw.ts && tsx scripts/prerender-landing.ts",
    "build:server": "tsx scripts/build-server.ts",
    "security:headers": "node scripts/security-headers-grade.mjs",
    "start": "node dist/server/node.js",
    "db:generate": "drizzle-kit generate && tsx scripts/bundle-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:d1-retry": "node scripts/qa/d1-retry-check/run.mjs",
    "build:worker": "tsx scripts/build-llms.ts && tsx scripts/build-worker.ts",
    "build:preview": "npm run build:web && tsx scripts/build-worker.ts --profile preview",
    "test:e2e": "playwright test",
    "test:e2e:staging-readonly": "E2E_ALLOW_REMOTE=1 E2E_BASE_URL=https://mymail-staging.mymail-app.workers.dev playwright test e2e/launch-checklist.spec.ts --grep \"real 404|robots|sitemap|favicon\" --workers=1",
    "check": "npm run typecheck && npm run lint && npm run lint:copy && npm test",
    "lint:copy": "tsx scripts/check-copy.ts",
    "mailserver:setup": "tsx scripts/stalwart-setup.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "design:audit": "node scripts/design-audit.mjs",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "test:coverage": "vitest run --coverage",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "perf:lh": "node scripts/lighthouse-r30.mjs",
    "security": "node scripts/security-check.mjs",
    "hooks:install": "git config core.hooksPath scripts/githooks"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fullcalendar/react": "^7.1.4",
    "@hono/mcp": "^0.3.5",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@livekit/components-react": "^2.9.25",
    "@livekit/components-styles": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.12",
    "@sentry/cloudflare": "^11.11.0",
    "@sentry/node": "^11.11.0",
    "@sentry/react": "^11.11.0",
    "@simplewebauthn/browser": "13.1.2",
    "@simplewebauthn/server": "13.1.2",
    "@svar-ui/react-gantt": "^2.8.2",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extension-collaboration": "^3.33.0",
    "@tiptap/extension-collaboration-caret": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/y-tiptap": "^3.2.0",
    "@xyflow/react": "^12.10.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.18",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cockatiel": "^4.0.0",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "email-reply-parser": "^2.3.9",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "hono": "^4.13.17",
    "hono-rate-limiter": "^0.5.4",
    "jose": "^6.2.16",
    "lib0": "^0.2.119",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "mailauth": "^8.0.4",
    "maplibre-gl": "^6.17.0",
    "mermaid": "^12.2.0",
    "minisearch": "^7.2.0",
    "nodemailer": "^10.4.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "postal-mime": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.20.0",
    "react-router": "^8.5.1",
    "read-excel-file": "^9.3.14",
    "recharts": "^3.10.1",
    "resend": "^6.37.0",
    "sonner": "^2.0.8",
    "standardwebhooks": "^1.1.1",
    "stripe": "^23.1.0",
    "temporal-polyfill": "^1.0.6",
    "uqr": "^0.1.3",
    "write-excel-file": "^4.1.1",
    "ws": "^8.22.2",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "imapflow": "^2.9.1",
    "otpauth": "^9.5.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "joi": "^18.3.1",
    "lodash-es": "^4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.20"
    }
  }
}
