# ---------------------------------------------------------------------------
# Multies configuration. Every variable the app and the self-host package read is
# listed here, grouped, with its default.
#
#   Your own computer (Docker):  node scripts/selfhost/gen-env.mjs   (or scripts/selfhost/setup.sh / setup.ps1)
#                                writes .env with strong secrets; see docs/self-host.md.
#   Local development:           cp .env.example .env   (the Node server reads .env on boot)
#   Cloudflare Workers:          set these as vars and secrets instead (wrangler.toml).
#
# Lines starting with # are off. Leave optional values commented out rather than empty:
# an empty value counts as set.
# .env is git-ignored. Never commit it.
# ---------------------------------------------------------------------------

# === Core ==================================================================

# production | development. Production refuses to boot without APP_SECRET and sets
# Secure cookies. Defaults to development unless NODE_ENV=production.
APP_MODE=development
# NODE_ENV=production

# Public URL of the app: links in emails, sign-in callbacks, the inbound webhook URL.
# Self-host on this computer: http://localhost:8787. With a domain: https://app.example.com
APP_URL=http://localhost:5173

# Product name in emails and the browser tab.
# APP_NAME=Multies

# Root secret that encrypts DKIM keys, webhook secrets and API keys at rest.
# REQUIRED in production: 32+ random characters (gen-env.mjs makes one).
# Changing it makes existing encrypted secrets unreadable. Back it up with your data.
APP_SECRET=

# SQLite file for the Node server (Workers use the D1 binding instead).
# In Docker this is /data/mymail.db on the mymail-data volume.
DATABASE_PATH=.data/mymail.db

# Port the Node server listens on inside its container or on this computer.
# PORT=8787

# Release name shown in /api/config and error reports.
# RELEASE=dev

# "Try the live demo" and POST /api/account/demo (sample workspaces, purged after 24 hours).
DEMO_MODE=false
# Public booking pages (/book/<slug>) and the scheduling API. Off unless true.
SCHEDULING_ENABLED=false

# DNS lookups for domain checks: doh (DNS over HTTPS, works everywhere) or node (the OS resolver).
DNS_RESOLVER=doh

# Comma separated emails that get the platform admin pages (user delete and so on).
# PLATFORM_ADMIN_EMAILS=you@example.com

# Operator console (/console). In production a session must have given a second factor at sign in (the password and
# the two-step code, a backup code, or a passkey), or have signed in through a method listed below; the account having
# two-step turned on is not enough on its own. "on" requires it everywhere, "off" turns it off. Operator roles can only
# be given to accounts with two-step on. Sensitive actions need a sign in within the last N minutes.
# OPERATOR_REQUIRE_2FA=on
# Sign-in methods that count as two-step for the operator console (comma separated, empty by default).
# List a sign-in method here only if that provider enforces multi-factor for every operator.
# OPERATOR_SSO_METHODS=
# OPERATOR_FRESH_MINUTES=15

# Contact for security reports (mailto: or https:). Default: mailto:security@<APP_URL host>.
# SECURITY_CONTACT=mailto:security@example.com

# Check new passwords against known breaches (k-anonymity range lookup). Default: on in production.
# PASSWORD_BREACH_CHECK=true

# === Mail routing (the DNS records Multies asks customers to publish) =========

# MX hosts, host:priority, comma separated. Default: Cloudflare Email Routing
# (route1/2/3.mx.cloudflare.net). Self-host with a domain: your mail host, e.g. mail.example.com:10
# MAIL_MX_HOSTS=route1.mx.cloudflare.net:10,route2.mx.cloudflare.net:20,route3.mx.cloudflare.net:30

# SPF includes. Default: _spf.mx.cloudflare.net (+ amazonses.com when Resend is on).
# Self-host: a TXT record you publish, e.g. _spf.mail.example.com (see docs/self-host.md).
# MAIL_SPF_INCLUDES=_spf.mx.cloudflare.net,amazonses.com

# DKIM selector for generated keys (record host becomes <selector>._domainkey).
MAIL_DKIM_SELECTOR=mymail

# Address for DMARC aggregate reports (default dmarc@<customer domain>).
# MAIL_DMARC_RUA=dmarc-reports@example.com

# Largest inbound message accepted, bytes (default 10 MB).
# MAX_MESSAGE_BYTES=10485760

# Shared domain for agent inboxes (agent-name@<domain>).
# AGENT_MAIL_DOMAIN=agents.example.com

# === Sending mail ============================================================

# log (default without a key: stores outbound mail, sends nothing) or resend.
# SMTP_HOST below takes over from log when it is set.
OUTBOUND_DRIVER=log
# RESEND_API_KEY=re_...
# Signing secret of the Resend webhook pointed at /api/webhooks/resend (bounces, complaints).
# RESEND_WEBHOOK_SECRET=whsec_...

# SMTP sending (Node server only). docker-compose.selfhost.yml sets SMTP_HOST=stalwart,
# SMTP_PORT=587 and SMTP_ALLOW_SELF_SIGNED=true for you; set SMTP_USER and SMTP_PASS here.
# Messages are DKIM signed with the domain's key from Multies.
# SMTP_HOST=stalwart
# SMTP_PORT=587
# SMTP_SECURE=false                   (true for port 465)
# SMTP_ALLOW_SELF_SIGNED=false        (true only for a mail server on the same private network)
SMTP_USER=mymail-relay@ops.mymail.local
SMTP_PASS=

# Development only: write every message the log driver records as JSON into this folder.
# OUTBOX_DIR=.data/outbox

# Sender for account emails (invites, password resets, verification).
# Default: no-reply@<APP_URL host>. Must be a domain your sending route can send from.
# SYSTEM_FROM=no-reply@example.com
# SYSTEM_FROM_NAME=Multies

# === Mail apps (IMAP and SMTP) through Stalwart, docs/mail-server.md ========

# All three turn it on. docker-compose.selfhost.yml sets STALWART_URL=http://stalwart:8080.
# STALWART_URL=http://stalwart:8080
STALWART_ADMIN_USER=mymail-provisioner@ops.mymail.local
STALWART_ADMIN_SECRET=
# What people type into their mail app. On this computer only: localhost.
MAIL_CLIENT_HOST=localhost
# MAIL_IMAP_PORT=993
# MAIL_SMTP_PORT=465                  (587 means STARTTLS)

# === Self-host package (docker-compose.selfhost.yml) =========================

# A domain name for Stalwart's own accounts (the provisioner and the sending account).
# It never needs DNS; keep it matching STALWART_ADMIN_USER and SMTP_USER.
MAIL_OPS_DOMAIN=ops.mymail.local
# Stalwart's built-in administrator, used only while setting it up (user:password).
STALWART_SETUP_ADMIN=
# Shared token between Stalwart and the mail bridge (inbound mail into Multies).
MTA_HOOK_TOKEN=
# Inbound keys from Multies, Settings, Inbound: keyId:secret, comma separated, one per workspace.
# Until one is set, mail arriving on port 25 gets "try again later".
MYMAIL_INBOUND_KEYS=
# Ports on this computer.
# MYMAIL_PORT=8787
# SMTP_IN_PORT=25
# STALWART_ADMIN_PORT=8080
# Stalwart image tag.
# STALWART_VERSION=v0.16
# Cloudflare token and account, only for moving data across from Cloudflare D1
# (scripts/selfhost/d1-export.sh). Remove them afterwards.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Only for the older docker-compose.yml setup flow (scripts/stalwart-setup.ts):
# STALWART_RECOVERY_MODE=1
# STALWART_RECOVERY_ADMIN=admin:...   (remove after setup)

# === Sign in (see docs/auth.md) ===============================================

# The identity provider (Auth0, OIDC). When set, its Universal Login is the one sign in and
# sign up page, and the app's own password form turns off unless AUTH_LOCAL_PASSWORD=on.
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_CLIENT_ID=            (Regular Web Application)
# AUTH0_CLIENT_SECRET=
# AUTH0_NATIVE_CLIENT_ID=     (Native application for the mobile app; enables /api/auth/mobile/exchange)
# AUTH0_SOCIAL_CONNECTIONS=   (e.g. google-oauth2,windowslive: "Continue with Google / Microsoft" buttons; docs/runbooks/social-login.md)
# AUTH_LOCAL_PASSWORD=on|off  (default: off with the identity provider, on without it)
# TRUST_PROXY=true            (self host behind your own proxy: believe X-Forwarded-For)

# Direct social sign in, only for deployments without the identity provider:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# === Billing (Stripe, optional) ==============================================

# Billing turns on when STRIPE_SECRET_KEY is set (a restricted rk_ key works);
# until then plans switch freely and Settings, Billing shows "billing not connected".
# Webhook endpoint: <APP_URL>/api/webhooks/stripe with events checkout.session.completed,
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted,
# invoice.paid, invoice.payment_failed
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...          (recurring monthly price for Pro)
# STRIPE_PRICE_BUSINESS=price_...     (recurring monthly price for Business)
# Days a workspace keeps paid features after a failed payment (0 to 60, default 7).
# BILLING_GRACE_DAYS=7

# === Error reporting (Sentry, optional) =====================================

# SENTRY_DSN_API=
# SENTRY_DSN_WEB=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Outside URLs the status page checks (comma separated, http or https).
# MONITOR_URLS=

# === Large message bodies in S3-compatible storage (optional) ===============

# BODY_STORE_ENDPOINT=https://s3.ap-southeast-2.amazonaws.com
# BODY_STORE_BUCKET=
# BODY_STORE_REGION=auto
# BODY_STORE_ACCESS_KEY_ID=
# BODY_STORE_SECRET_ACCESS_KEY=

# === Imports, integrations, meetings, forms, push (optional) =================

# Token for the IMAP import runner (deploy/import-runner), 24+ characters.
# IMPORT_RUNNER_TOKEN=
# Xero integration.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# Video meetings with LiveKit (off when unset).
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Spam protection on public forms (Cloudflare Turnstile, free).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Mobile push through Expo (off unless set to 1).
# PUSH_ENABLED=0
# EXPO_ACCESS_TOKEN=

# === AI (optional) ============================================================

# Built-in AI answering in place of a workspace's own AI key while its provider refuses it
# (needs AI_CONNECT_AI2=on). Off unless set to on. Before turning it on, update the privacy
# policy and sub processor rows (src/shared/legal.ts, src/shared/trust.ts): the workspace's
# text then goes to built-in AI instead of the provider it chose.
# AI_KEY_FALLBACK=off
