# ---------------------------------------------------------------------------
# MyMail configuration. Copy to .env for local development (Node reads it on boot).
# On Cloudflare Workers set these as vars/secrets instead (see wrangler.toml).
# ---------------------------------------------------------------------------

# production | development. Production refuses to boot without APP_SECRET and
# sets Secure cookies. Defaults to development unless NODE_ENV=production.
APP_MODE=development

# Public URL of the app (used for the inbound webhook URL shown in Settings).
APP_URL=http://localhost:5173

# Root secret for encrypting DKIM private keys and webhook secrets at rest.
# REQUIRED in production: at least 32 random characters, e.g. `openssl rand -base64 48`.
# Changing it makes existing encrypted secrets unreadable.
APP_SECRET=

# SQLite file for the Node server. (On Workers the D1 binding `DB` is used.)
DATABASE_PATH=.data/mymail.db

# Show "Try the live demo" and allow POST /api/auth/demo (sandbox workspaces with
# sample data, purged after 24h). Leave off in production unless you want public demos.
DEMO_MODE=false

# DNS lookups: doh (DNS-over-HTTPS via Cloudflare/Google; works everywhere) or node (OS resolver).
DNS_RESOLVER=doh

# --- Mail routing ----------------------------------------------------------
# MX hosts customers must publish, host:priority, comma separated.
# Default: Cloudflare Email Routing (route1/2/3.mx.cloudflare.net).
# MAIL_MX_HOSTS=route1.mx.cloudflare.net:10,route2.mx.cloudflare.net:20,route3.mx.cloudflare.net:30

# SPF includes customers must publish. Default: _spf.mx.cloudflare.net (+ amazonses.com when Resend is on).
# MAIL_SPF_INCLUDES=_spf.mx.cloudflare.net,amazonses.com

# DKIM selector for generated keys (record host becomes <selector>._domainkey).
MAIL_DKIM_SELECTOR=mymail

# Optional address for DMARC aggregate reports (default dmarc@<customer domain>).
# MAIL_DMARC_RUA=dmarc-reports@yourplatform.com

# Largest inbound message accepted, bytes (default 10 MB).
# MAX_MESSAGE_BYTES=10485760

# --- Outbound -------------------------------------------------------------
# log (default without a key: stores outbound mail, sends nothing externally) or resend.
OUTBOUND_DRIVER=log
# RESEND_API_KEY=re_...
