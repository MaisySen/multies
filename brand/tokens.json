{
  "$comment": "Multies design tokens. Mirrors src/web/index.css. Colours are hex or rgba; sizes in points (1 pt = 1 CSS px).",
  "font": {
    "family": {
      "ios": "System (SF Pro)",
      "android": "System (Roboto)",
      "web": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", Roboto, Inter, system-ui, sans-serif",
      "mono": "ui-monospace, SF Mono, Menlo, monospace"
    },
    "size": {
      "caption": 12,
      "footnote": 13,
      "subhead": 15,
      "body": 17,
      "headline": 17,
      "title3": 20,
      "title2": 22,
      "title1": 28,
      "largeTitle": 34
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "color": {
    "light": {
      "background": "#F5F5F7",
      "surface": "#FFFFFF",
      "elevated": "#FFFFFF",
      "hover": "#EBEBEF",
      "fill": "#E8E8ED",
      "separator": "rgba(0,0,0,0.09)",
      "separatorStrong": "rgba(0,0,0,0.16)",
      "label": "#1D1D1F",
      "secondaryLabel": "#5A5A5F",
      "tertiaryLabel": "#606065",
      "accent": "#0066CC",
      "accentPressed": "#0058B0",
      "accentSoft": "rgba(0,102,204,0.10)",
      "onAccent": "#FFFFFF",
      "success": "#17692C",
      "successSoft": "rgba(36,138,61,0.12)",
      "warning": "#8A4B00",
      "warningSoft": "rgba(255,159,10,0.16)",
      "danger": "#B00017",
      "dangerSoft": "rgba(215,0,21,0.10)"
    },
    "dark": {
      "background": "#0C0C0D",
      "surface": "#161618",
      "elevated": "#1F1F22",
      "hover": "#2A2A2D",
      "fill": "#2C2C2F",
      "separator": "rgba(255,255,255,0.09)",
      "separatorStrong": "rgba(255,255,255,0.16)",
      "label": "#F5F5F7",
      "secondaryLabel": "#AEAEB2",
      "tertiaryLabel": "#9A9A9F",
      "accent": "#0071E3",
      "accentPressed": "#5EA4FF",
      "accentText": "#5EA4FF",
      "accentSoft": "rgba(10,132,255,0.16)",
      "onAccent": "#FFFFFF",
      "success": "#30D158",
      "successSoft": "rgba(48,209,88,0.14)",
      "warning": "#FFB340",
      "warningSoft": "rgba(255,179,64,0.14)",
      "danger": "#FF7A72",
      "dangerSoft": "rgba(255,105,97,0.14)"
    },
    "brand": {
      "blue": "#0071E3",
      "ink": "#1D1D1F",
      "paper": "#F5F5F7"
    },
    "labels": {
      "$comment": "Muted defaults for labels and tags. Use the text colour of the pair on its soft fill.",
      "grey": "#8E8E93",
      "blue": "#5B7FA6",
      "teal": "#4F8A8B",
      "green": "#5E8C61",
      "amber": "#A3824A",
      "red": "#A65E5E",
      "purple": "#7D6B9E"
    }
  },
  "space": {
    "$comment": "8 pt grid, with 4 for tight spots",
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "radius": {
    "sm": 6,
    "md": 8,
    "lg": 10,
    "xl": 14,
    "2xl": 16,
    "sheet": 14
  },
  "touchTarget": 44,
  "shadow": {
    "card": "0 1 2 rgba(0,0,0,0.04)",
    "pop": "0 12 32 rgba(0,0,0,0.18)"
  },
  "motion": {
    "duration": {
      "fast": 150,
      "base": 200,
      "slow": 250,
      "sheet": 280
    },
    "easing": {
      "out": [
        0.22,
        1,
        0.36,
        1
      ],
      "spring": [
        0.32,
        0.72,
        0,
        1
      ]
    },
    "reduceMotion": "Respect the system Reduce Motion setting: replace movement with a short fade or nothing."
  }
}
