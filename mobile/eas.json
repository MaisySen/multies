{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://preview.multies.si",
        "EXPO_PUBLIC_FEATURE_PUSH_SERVER": "1"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://preview.multies.si",
        "EXPO_PUBLIC_FEATURE_PUSH_SERVER": "1"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://multies.si",
        "EXPO_PUBLIC_FEATURE_PUSH_SERVER": "1"
      },
      "distribution": "store",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "default"
      }
    },
    "production-local-credentials": {
      "extends": "production",
      "credentialsSource": "local"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6826562106",
        "appleTeamId": "B85KQRQZW7"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "serviceAccountKeyPath": "./secrets/play-service-account.json"
      }
    }
  }
}
