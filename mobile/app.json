    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Multies",
      "themeColor": "#0071E3",
      "backgroundColor": "#F2F2F7",
      "lang": "en-AU"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-localization",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1D1D1F"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0071E3",
          "defaultChannel": "mail",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-asset",
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiBase": "https://multies.si",
      "eas": {
        "projectId": "83c874f8-cc92-4440-8ccd-5b99c2d8ec1f"
