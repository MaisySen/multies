{
  "expo": {
    "name": "Multies",
    "slug": "mymail",
    "scheme": "mymail",
    "version": "1.9.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F2F7",
    "description": "Email on your own domain, with your team and your AI agents in one inbox.",
