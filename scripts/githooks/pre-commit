#!/bin/sh
# Pre-commit: refuse a commit that adds a secret. Install once with: npm run hooks:install
# Uses gitleaks from PATH, or the copy npm run security downloads.
GL="$(command -v gitleaks || echo node_modules/.cache/gitleaks/gitleaks)"
if [ ! -x "$GL" ]; then
  echo "pre-commit: gitleaks not found. Run npm run security once, or install gitleaks." >&2
  exit 1
fi
exec "$GL" git --pre-commit --staged --no-banner --redact --config .gitleaks.toml .
